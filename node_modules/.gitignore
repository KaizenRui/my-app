START

# Ignore dependencies folder
IGNORE "node_modules/"

# Ignore build output folders
IGNORE "dist/"
IGNORE "build/"

# Ignore environment configuration files
IGNORE ".env"
IGNORE ".env.local"

# Ignore log files generated by npm or yarn
IGNORE "npm-debug.log*"
IGNORE "yarn-debug.log*"
IGNORE "yarn-error.log*"

# Ignore system-generated files
IGNORE ".DS_Store"
IGNORE "Thumbs.db"

END
